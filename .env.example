# ============================================================
#  MGM Financiers — Environment Configuration
#  Copy this to .env and fill in your values
# ============================================================

# Domain (used in Traefik routing)
DOMAIN=mgmfinanciers.com

# MongoDB (NEVER commit real credentials)
MONGO_URI=mongodb://admin:CHANGE_ME@mongodb:27017/mgm-financiers?authSource=admin

# JWT Secrets (generate random 64-char hex strings for production)
ADMIN_JWT_SECRET=CHANGE_ME_generate_random_64_char_hex
USER_JWT_SECRET=CHANGE_ME_generate_random_64_char_hex
JWT_ACCESS_SECRET=CHANGE_ME_generate_random_64_char_hex
JWT_REFRESH_SECRET=CHANGE_ME_generate_random_64_char_hex
JWT_ACCESS_EXPIRES_IN=15d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Server
NODE_ENV=production
PORT=4000

# CORS (comma-separated origins)
CORS_ORIGINS=https://mgmfinanciers.com,https://admin.mgmfinanciers.com,https://consent.mgmfinanciers.com

# Frontend URLs
FRONTEND_BASE=https://mgmfinanciers.com
CONSENT_URL=https://consent.mgmfinanciers.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cashfree Payment Gateway (NEVER commit real keys)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Admin Panel
ADMIN_AUTH_NAME=mgm_admin_auth

# Google Analytics 4 (optional — enables dashboard analytics)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_KEY=

# Docker Image Tag
IMAGE_TAG=latest
